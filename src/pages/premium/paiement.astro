---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';

import Fleche from '../../assets/fleche.svg';
---

<Layout title="Paiement Premium">

    <main class="px-8 py-10">

        <a
            href="/premium"
            class="
                inline-flex
                items-center
                gap-3
                rounded-full
                bg-orange-c/70
                px-6
                py-3
                text-white
            "
        >
            <Image src={Fleche} alt="" class="h-4 w-4" />
            Retour
        </a>

        <h2 class="mt-12 text-paprika-c">
            Paiement Premium
        </h2>

        <div
            class="
                mt-8
                rounded-3xl
                border-2
                border-yellow-c
                bg-white-c
                p-6
            "
        >

            <h3>
                Démonstration
            </h3>

            <p class="mt-4">
                Cette page est une maquette.
                Aucun paiement réel n'est effectué.
            </p>

            <input
                type="text"
                placeholder="Numéro de carte"
                class="
                    mt-8
                    w-full
                    rounded-2xl
                    border-2
                    border-mocha-c
                    p-4
                "
            >

            <div class="mt-4 flex gap-4">

                <input
                    type="text"
                    placeholder="MM/AA"
                    class="
                        w-1/2
                        rounded-2xl
                        border-2
                        border-mocha-c
                        p-4
                    "
                >

                <input
                    type="text"
                    placeholder="CVC"
                    class="
                        w-1/2
                        rounded-2xl
                        border-2
                        border-mocha-c
                        p-4
                    "
                >

            </div>

            <button
                class="
                    mt-8
                    w-full
                    rounded-full
                    bg-paprika-c
                    py-4
                    text-white
                "
            >
                Payer
            </button>

        </div>

    </main>

</Layout>