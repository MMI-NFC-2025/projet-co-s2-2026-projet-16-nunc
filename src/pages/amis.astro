---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import Fleche from '../assets/fleche.svg';
---

<Layout title="Listes de tes amis">
    <main class="px-8 py-10 pb-32">
        <a
            href="/"
            class="inline-flex items-center gap-3 rounded-full bg-orange-c/70 px-6 py-3 text-white"
        >
            <Image src={Fleche} alt="" class="h-4 w-4" />
            Retour
        </a>
    </main>
</Layout>