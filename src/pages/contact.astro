---
import Layout from '../layouts/Layout.astro';
import Fleche from '../assets/fleche.svg';
import Flechegauche from '../assets/fleche-gauche.svg';
import Flechedroite from '../assets/fleche-droite.svg';
import Mail from '../assets/mail.svg';
import Telephone from '../assets/telephone.svg';
import Localisation from '../assets/carte.svg';
import Instagram from '../assets/instagram.svg';
import Tiktok from '../assets/tiktok.svg';
import Facebook from '../assets/facebook.svg';

import { Image } from 'astro:assets';
---

<Layout title="Contact">
    <main class="px-8 py-10">
        <a
            href="/"
            class="inline-flex items-center gap-3 rounded-full bg-orange-c/70 px-6 py-3 text-white"
        >
            <Image
                src={Fleche}
                alt=""
                class="w-4 h-4"
            />

            Retour
        </a>

        <section class="mt-16">
            <h2 class="text-paprika-c">
                Contactez-nous
            </h2>

            <p class="mt-6 max-w-md">
                Une question, une suggestion ou besoin d'aide ? N'hésitez pas à nous contacter.
                Notre équipe vous répondra dans les plus brefs délais.
            </p>
        </section>

        <section class="mt-16 rounded-lg border border-mocha-c bg-white-c px-6 py-8">
            <form
                id="contact-form"
                class="flex flex-col gap-8"
            >

                <label class="block">
                    Nom complet *

                    <input
                        type="text"
                        name="nom"
                        required
                        placeholder="Votre nom"
                        class="mt-4 w-full rounded-lg border border-yellow-c bg-white-bk px-5 py-4 placeholder:text-marron-c outline-none focus:border-paprika-c"
                    />
                </label>

                <label class="block">
                    Email *

                    <input
                        type="email"
                        name="email"
                        required
                        placeholder="votre.email@exemple.com"
                        class="mt-4 w-full rounded-lg border border-yellow-c bg-white-bk px-5 py-4 placeholder:text-marron-c outline-none focus:border-paprika-c"
                    />
                </label>

                <label class="block">
                    Sujet *

                    <input
                        type="text"
                        name="sujet"
                        required
                        placeholder="Le sujet de votre message"
                        class="mt-4 w-full rounded-lg border border-yellow-c bg-white-bk px-5 py-4 placeholder:text-marron-c outline-none focus:border-paprika-c"
                    />
                </label>

                <label class="block">
                    Message *

                    <textarea
                        name="message"
                        required
                        placeholder="Écrivez votre message ici..."
                        rows="7"
                        class="mt-4 w-full resize-none rounded-lg border border-yellow-c bg-white-bk px-5 py-4 placeholder:text-marron-c outline-none focus:border-paprika-c"
                    ></textarea>
                </label>

                <div
                    id="retour-contact"
                    class="hidden rounded-lg px-4 py-3 font-semibold"
                ></div>

                <button
                    type="submit"
                    id="btn-contact"
                    class="mt-2 flex items-center justify-between rounded-full bg-paprika-c px-6 py-4 text-white-bk font-bold"
                >

                    <Image
                        src={Flechegauche}
                        alt=""
                        class="w-10 h-10"
                    />

                    Envoyer le message

                    <Image
                        src={Flechedroite}
                        alt=""
                        class="w-10 h-10"
                    />
                </button>
            </form>
        </section>

        <section class="mt-16 flex flex-col gap-12">
            <article class="flex items-start gap-6 rounded-2xl bg-white-c px-8 py-6">

                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yellow-c">
                    <Image
                        src={Mail}
                        alt=""
                        class="h-6 w-6"
                    />
                </div>

                <div>
                    <p>Email</p>

                    <small class="mt-1 block leading-relaxed text-marron-c">
                        contact@nunc.app
                    </small>

                    <small class="block text-marron-c">
                        support@nunc.app
                    </small>
                </div>
            </article>

            <article class="flex items-start gap-6 rounded-2xl bg-white-c px-8 py-6">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yellow-c">
                    <Image
                        src={Telephone}
                        alt=""
                        class="h-6 w-6"
                    />
                </div>

                <div>
                    <p>Téléphone</p>

                    <small class="mt-1 block leading-relaxed text-marron-c">
                        +33 1 23 45 67 89
                    </small>

                    <label class="block text-marron-c">
                        Du lundi au vendredi, 9h - 18h
                    </label>
                </div>
            </article>

            <article class="flex items-start gap-6 rounded-2xl bg-white-c px-8 py-6">
                <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-yellow-c">
                    <Localisation class="h-6 w-6 text-white" />
                </div>

                <div>
                    <p>Adresse</p>

                    <small class="mt-1 block leading-relaxed text-marron-c">
                        123 Avenue des Champs-Élysées
                    </small>

                    <small class="block text-marron-c">
                        75008 Paris, France
                    </small>
                </div>
            </article>
        </section>

        <section class="mt-15 rounded-2xl bg-beige-c px-6 py-6 text-center">
            <h3 class="text-bordeaux-c">
                Réseaux sociaux
            </h3>

            <small class="mt-3 block leading-relaxed">
                Suivez-nous pour rester informé des dernières nouveautés !
            </small>

            <div class="mt-4 flex justify-center gap-4">
                <a
                    href="/"
                    class="flex h-15 w-15 items-center justify-center rounded-2xl bg-paprika-c"
                >
                    <Instagram class="h-11 w-11 text-white" />
                </a>

                <a
                    href="/"
                    class="flex h-15 w-15 items-center justify-center rounded-2xl bg-paprika-c"
                >
                    <Tiktok class="h-11 w-11 text-white" />
                </a>

                <a
                    href="/"
                    class="flex h-15 w-15 items-center justify-center rounded-2xl bg-paprika-c"
                >
                    <Facebook class="h-11 w-11 text-white" />
                </a>
            </div>
        </section>
    </main>
</Layout>

<script type="module" src="/src/js/contact.js"></script>