---
import Layout from '../layouts/Layout.astro';
---

<Layout>
<button id="logout">Se déconnecter</button>

<script>
  import pb from "../../backend/backend.mjs";

  document.getElementById("logout").addEventListener("click", () => {
    pb.authStore.clear();
    window.location.href = "/connexion";
  });
</script>
</Layout>
