---
const { title, description } = Astro.props;
---

<header class="w-full px-6 py-10 bg-gradient-to-br from-paprika-c to-yellow-c">
  <div class="max-w-md ml-4">
    <h1 class="text-white-bk">
      {title}
    </h1>

    {description && (
      <small class="mt-2 block text-white-bk">
        {description}
      </small>
    )}
  </div>
</header>