---
const { title, description } = Astro.props;
---

<header class="w-full px-6 py-10 bg-gradient-to-br from-paprika-c to-yellow-c">
  <div class="max-w-md ml-4">
    <h1 class="text-4xl font-titan text-white-bk">
      {title}
    </h1>

    {description && (
      <p class="mt-2 text-sm text-white-bk">
        {description}
      </p>
    )}
  </div>
</header>