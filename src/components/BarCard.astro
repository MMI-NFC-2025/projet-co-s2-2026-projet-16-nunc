---
import Star from '../assets/etoile.svg';
import PbImage from '../components/PbImage.astro';
import { Image } from 'astro:assets';

const {
    nom,
    categorie,
    distance,
    note,
    record
} = Astro.props;
---

<a href={`/carte/${record.id}`}>
    <article
        class="bar-card flex items-center justify-between rounded-3xl border border-paprika-c bg-white-c p-3"
    >
        <div class="flex items-center gap-5">
            <div class="h-16 w-16 shrink-0 overflow-hidden rounded-lg">
                <PbImage
                    record={record}
                    imageField="image"
                />
            </div>

            <div>
                <p class="font-bold">
                    {nom}
                </p>

                <label class="mt-2 text-mocha-c">
                    {categorie} • {distance} km
                </label>
            </div>
        </div>

        <div class="flex items-center gap-1">
            <Image
                src={Star}
                alt=""
                class="h-4 w-4 shrink-0"
            />

            <label class="font-bold">
                {note}
            </label>
        </div>
    </article>
</a>