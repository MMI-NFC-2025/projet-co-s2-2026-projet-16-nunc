---
import Calendrier from '../assets/sortie.svg';
import Carte from '../assets/carte.svg';
import People from '../assets/people.svg';

const {
    titre = '',
    date = '',
    bar = '',
    participants = ''
} = Astro.props;
---

<article class="rounded-3xl border border-paprika-c bg-white-c p-5">
    <h4 class="font-titan leading-none">{titre}</h4>

    <div class="mt-2 flex flex-col gap-2">
        <div class="flex items-center justify-between">

            <div class="flex items-center gap-2">
                <Calendrier class="h-5 w-5 shrink-0" />
                <span class="text-base">{date}</span>
            </div>

            <div class="flex items-center gap-2">
                <People class="h-5 w-5 shrink-0" />
                <span class="text-base">{participants}</span>
            </div>
        </div>

        <div class="flex items-center gap-2 text-paprika-c">
            <Carte class="h-5 w-5 shrink-0" />
            <span class="text-base">{bar}</span>
        </div>
    </div>
</article>
