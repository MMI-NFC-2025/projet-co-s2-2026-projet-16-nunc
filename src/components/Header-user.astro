---
import Logo from '../assets/logo-white.svg';
import Trophy from '../assets/profil.svg';
import Courone from '../assets/courone.svg';
import { Image } from 'astro:assets';
---

<header class="w-full px-6 py-10 bg-gradient-to-br from-paprika-c to-yellow-c">
    <div class="flex justify-between items-start">
        <div>
            <h3 class="text-white-c text-3xl leading-none">Salut,</h3>
            <h3 id="username" class="text-white-bk text-3xl leading-none mt-2">Utilisateur !</h3>
            <small class="mt-4 block text-white-bk pr-7">Prêt pour de nouvelles aventures ?</small>
        </div>
        
        <Image src={Logo} alt="Logo NUNC" class="w-34 h-auto" />
    </div>
    
    <div class="mt-5 bg-white-c rounded-3xl p-6">
        <div class="flex justify-between items-center">
            
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-beige-c flex items-center justify-center shrink-0">
                    <Image src={Trophy} alt="" class="w-6 h-6" />
                </div>
                
                <div>
                    <h4 id="level" class="font-titan leading-none">Niveau 1</h4>
                    <small id="points" class="mt-3 text-marron-c">0 / 250 points</small>
                </div>
            </div>
            
            <span id="premium-badge" class="hidden bg-paprika-c text-white-bk px-3 py-2 rounded-full flex items-center gap-3">
                <Image src={Courone} alt="" class="w-4 h-4" />
                Premium
            </span>
        </div>
        
        <div class="mt-8 h-5 bg-white rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-orange-c rounded-full transition-all duration-500" style="width:0%"></div>
        </div>
    </div>
</header>

<script type="module" src="/src/js/header-user.js"></script>
