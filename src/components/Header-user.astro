---
import Logo from '../assets/logo-white.svg';

import Trophy from '../assets/profil.svg';
import Courone from '../assets/courone.svg';

import { Image } from 'astro:assets';
import { getUserById, loadAstroAuth } from '../../backend/backend.mjs';

const { pb, user: localUser } = await loadAstroAuth(Astro);
const authUser = localUser?.record || localUser || pb?.authStore?.record || null;
const authUserId = authUser?.id || localUser?.id || localUser?.record?.id || pb?.authStore?.record?.id;

const user = authUserId
    ? await getUserById(authUserId, pb).catch(() => authUser)
    : authUser;

const points = Number(user?.points || 0);
const level = Number(user?.niveau || Math.floor(points / 250) + 1);
const maxXp = level * 250;
const progress = maxXp > 0 ? Math.min((points / maxXp) * 100, 100) : 0;
const username =
    user?.username ||
    [user?.prenom, user?.nom].filter(Boolean).join(' ') ||
    user?.email ||
    'Utilisateur';
const isPremium = Boolean(user?.premium);
---

<header class="w-full px-6 py-10 bg-linear-to-br from-paprika-c to-yellow-c">
    <div class="flex justify-between items-start gap-4 overflow-hidden">
        <div class="min-w-0 flex-1">
            <h3 class="text-white-c text-3xl leading-none">Salut,</h3>
            <h3 id="username" class="text-white-bk text-3xl leading-none mt-2 break-words">{username} !</h3>
            <small class="mt-4 block text-white-bk pr-7">Prêt pour de nouvelles aventures ?</small>
        </div>
        
        <Image src={Logo} alt="Logo NUNC" class="w-28 h-auto shrink-0 sm:w-34" />
    </div>
    
    <div class="mt-5 bg-white-c rounded-3xl p-6">
        <div class="flex justify-between items-center">
            
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-full bg-beige-c flex items-center justify-center shrink-0">
                    <Image src={Trophy} alt="" class="w-6 h-6" />
                </div>
                
                <div>
                    <h4 id="level" class="font-titan leading-none">Niveau {level}</h4>
                    <small id="points" class="mt-3 text-marron-c">{points} / {maxXp} points</small>
                </div>
            </div>
            
            <span id="premium-badge" class:list={[
                'bg-paprika-c text-white-bk px-3 py-2 rounded-full flex items-center gap-3',
                { hidden: !isPremium }
            ]}>
                <Image src={Courone} alt="" class="w-4 h-4" />
                Premium
            </span>
        </div>
        
        <div class="mt-8 h-5 bg-white rounded-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-orange-c rounded-full transition-all duration-500" style={`width:${progress}%`}></div>
        </div>
    </div>
</header>
