<article
    id="invitation-template"
    class="hidden rounded-3xl border border-mocha-c bg-white-c p-5"
>

    <h4
        class="invitation-title text-bordeaux-c font-titan"
    ></h4>

    <small>
        Invitation de
        <span
            class="invitation-expediteur text-paprika-c"
        ></span>
    </small>

    <div
        class="mt-4 flex gap-3"
    >

        <button
            class="accept-btn flex-1 rounded-full bg-paprika-c py-3 text-white"
        >
            Accepter
        </button>

        <button
            class="refuse-btn flex-1 rounded-full border-2 border-paprika-c py-3 text-paprika-c"
        >
            Refuser
        </button>

    </div>

</article>