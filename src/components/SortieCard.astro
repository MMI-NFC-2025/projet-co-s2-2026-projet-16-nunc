---
import Calendrier from '../assets/sortie.svg';
import Carte from '../assets/carte.svg';
import People from '../assets/people.svg';
---

<article id="sortie-template" class="hidden rounded-4xl border-2 border-mocha-c bg-white-c p-6">
    <h3 class="sortie-title text-paprika-c"></h3>
    <p class="mt-2 font-bold">
        <span class="sortie-organisateur text-paprika-c"></span>
        a créé(e) cet évènement
    </p>
    
    <div class="mt-4 flex flex-col gap-3">
        <p class="flex items-center gap-3">
            <Calendrier class="h-6 w-6" />
            <span class="sortie-date"></span>
        </p>
        
        <p class="flex items-center gap-3">
            <Carte class="h-6 w-6" />
            <span class="sortie-bar"></span>
        </p>
        
        <p class="flex items-center gap-3">
            <People class="h-6 w-6" />
            <span class="sortie-participants"></span>
        </p>
    </div>
</article>
