---
import Calendrier from '../assets/sortie.svg';
import Carte from '../assets/carte.svg';
import People from '../assets/people.svg';
import UserAvatar from './UserAvatar.astro';

const {
    avatar = '',
    user = null,
    pb = null,
    organisateur = 'Utilisateur',
    titre = '',
    date = '',
    bar = '',
    participants = ''
} = Astro.props;
---

<article class="rounded-3xl border border-mocha-c bg-white-c pr-4 pl-2 py-5">
    <div class="flex gap-5">
        {user ? (
            <UserAvatar user={user} pb={pb} size="h-19 w-19" />
        ) : (
            <img class="h-19 w-19 shrink-0 rounded-full object-cover" src={avatar} alt="" />
        )}

        <div class="flex-1">
            <h4 class="text-bordeaux-c font-titan">{titre}</h4>

            <small class="mt-2 font-bold">
                <span class="text-lg text-paprika-c">{organisateur}</span>
                a créé(e) cet évènement
            </small>

            <div class="mt-2 flex flex-col">
                <small class="flex items-center gap-2">
                    <Calendrier class="h-4 w-4" />
                    <span>{date}</span>
                </small>

                <small class="flex items-center gap-2">
                    <Carte class="h-4 w-4" />
                    <span>{bar}</span>
                </small>

                <small class="flex items-center gap-2">
                    <People class="h-4 w-4" />
                    <span>{participants}</span>
                </small>
            </div>
        </div>
    </div>
</article>
