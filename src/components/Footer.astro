---
import Logo from '../assets/logo.svg';
import { Image } from 'astro:assets';
import Instagram from '../assets/instagram.svg';
import Facebook from '../assets/facebook.svg';
import Tiktok from '../assets/tiktok.svg';
---

<footer class="bg-beige-c/50 pb-12 mt-5">
  <div class="border-t-4 border-dashed border-paprika-c"></div>

  <div class="max-w-xs mx-auto">
    <div class="mt-16 flex justify-center">
      <Image 
        src={Logo} 
        alt="Logo NÜNC" 
        class="w-72 h-auto"
      />
    </div>

    <div class="mt-5 flex items-center gap-6 pl-4">
      <a href="/" aria-label="Instagram">
        <Image src={Instagram} alt="Instagram" class="w-9 h-9" />
      </a>

      <a href="/" aria-label="Facebook">
        <Image src={Facebook} alt="Facebook" class="w-9 h-9" />
      </a>

      <a href="/" aria-label="TikTok">
        <Image src={Tiktok} alt="TikTok" class="w-9 h-9" />
      </a>

      <a href="/" class="text-yellow-c text-3xl font-bold">
        @nunc
      </a>
    </div>

    <nav class="mt-10 pl-4">
      <ul class="space-y-5">
        <li><a href="/">À propos</a></li>
        <li><a href="/">Conditions d'utilisation</a></li>
        <li><a href="/">Mentions légales</a></li>
        <li><a href="/">Contact</a></li>
      </ul>
    </nav>

    <div class="mt-10 pl-4 text-center">
      <p>
        © 2026 NŨNC. Tous droits réservés.
      </p>

      <small class="mt-3 block text-paprika-c font-titan">
        Buvez avec modération
      </small>
    </div>
  </div>
</footer>