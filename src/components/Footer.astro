---
import Logo from '../assets/logo.svg';

import Instagram from '../assets/instagram.svg';
import Facebook from '../assets/facebook.svg';
import Tiktok from '../assets/tiktok.svg';

import { Image } from 'astro:assets';
---

<footer class="bg-beige-c/50 pb-12 mt-5 lg:mt-0 lg:pb-28">
  <div class="border-t-4 border-dashed border-paprika-c"></div>

  <div class="max-w-xs mx-auto lg:max-w-none lg:px-20 lg:pt-28 lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-start lg:gap-20">
    <div class="mt-16 flex flex-col items-center lg:mt-0 lg:block">
      <Image 
        src={Logo} 
        alt="Logo NÜNC" 
        loading="lazy"
        class="w-72 h-auto lg:w-80"
      />

      <div class="mt-5 flex items-center justify-center gap-6 lg:justify-start lg:pl-0 lg:gap-5">
        <a href="/" aria-label="Instagram">
          <Instagram class="w-9 h-9 text-yellow-c lg:w-10 lg:h-10" />
        </a>

        <a href="/" aria-label="Facebook">
          <Facebook class="w-9 h-9 text-yellow-c lg:w-10 lg:h-10" />
        </a>

        <a href="/" aria-label="TikTok">
          <Tiktok class="w-9 h-9 text-yellow-c lg:w-10 lg:h-10" />
        </a>

        <a href="/" class="text-yellow-c text-3xl font-bold">
          @nunc
        </a>
      </div>
    </div>

    <nav class="mt-10 pl-4 lg:mt-1 lg:pl-0 lg:justify-self-center">
      <ul class="space-y-5 lg:space-y-8 lg:text-xl">
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/">Conditions d'utilisation</a></li>
        <li>
          <a href="/mentions-legales">
            <span class="">Mentions légales</span>
          </a>
        </li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="mt-10 pl-4 text-center lg:mt-1 lg:pl-0 lg:justify-self-end lg:min-w-96 lg:text-right">
      <p>
        © 2026 NŨNC. Tous droits réservés.
      </p>

      <small class="mt-3 block text-paprika-c font-titan lg:text-right lg:text-base">
        Buvez avec modération
      </small>
    </div>
  </div>
</footer>
