---
import Layout from '../../layouts/Layout.astro';
import SortieCard from '../../components/SortieCard.astro';
import InvitationCard from '../../components/InvitationCard.astro';
---

<Layout title="Mes sorties" description="Organise, participe et gagne des points !">
    <main class="px-8 py-10 pb-32">
        <div class="flex rounded-2xl bg-white-c p-1">
            <button
                id="tab-events"
                class="tab-btn flex-1 rounded-2xl bg-paprika-c py-2 px-1 text-base text-white-bk"
            >
                Mes évènements
            </button>

            <button
                id="tab-invitations"
                class="tab-btn flex-1 rounded-2xl py-2 px-1 text-base"
            >
                Invitations
            </button>

            <button
                id="tab-history"
                class="tab-btn flex-1 rounded-2xl py-2 px-1 text-base"
            >
                Historique
            </button>
        </div>

        <section class="mt-8">
            <div
                id="sorties-container"
                class="flex flex-col gap-8"
            >
                <SortieCard />
            </div>

            <div
                id="invitations-container"
                class="hidden flex-col gap-8"
            >
                <InvitationCard />
            </div>
        </section>
    </main>
</Layout>

<script type="module" src="/src/js/sortie.js"></script>